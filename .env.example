# RPC endpoints (WebSocket) — only set the chains you want to monitor
ETH_RPC_WS=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ARB_RPC_WS=wss://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_WS=wss://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Master killswitch — true halts all listeners/executors (container stays alive)
KILLSWITCH=false

# Feature flags (true/false)
ENABLE_DEPLOYMENT_LISTENER=true   # master gate for the deployment listener
ENABLE_FACTORY_LISTENER=true      # master gate for the factory listener
ENABLE_VULN_DETECTORS=true
ENABLE_SNIPER=true
ENABLE_ARB_SCANNER=false          # default OFF — 2s poll burns ~34M CU/day, 0 proven edge
ENABLE_EXECUTOR=true

# Per-chain listener allowlists (comma-separated; empty string = none).
# The deployment listener fetches every block's full tx set, so its cost scales
# with block rate — Arbitrum (~4 blocks/s) is the biggest Alchemy sink and is
# excluded by default. The factory listener is a cheap log subscription (all chains).
DEPLOYMENT_CHAINS=ethereum,base
FACTORY_CHAINS=ethereum,arbitrum,base

# Executor
EXECUTOR_PRIVATE_KEY=0x...
EXECUTOR_LIVE=false

# Telegram alerts
TG_BOT_TOKEN=
TG_CHAT_ID=

# Database (defaults to ./backdraft.db)
DB_PATH=

# Flashbots (ETH mainnet, future)
FLASHBOTS_AUTH_KEY=
