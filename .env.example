# Backdraft seismographs. Everything defaults to keyless public endpoints;
# nothing here costs money to run. Copy to .env and fill what you use.

# ---- module toggles (default on) ----
ENABLE_DELTA=true
ENABLE_FUNDING=true
ENABLE_SPREAD=true

# ---- RPC (HTTP, keyless public defaults; override with your own node) ----
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# BASE_RPC_URL=https://mainnet.base.org
# ARB_RPC_URL=https://arb1.arbitrum.io/rpc
# HOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# ---- telegram (shared by all modules; blank = off) ----
TG_BOT_TOKEN=
TG_CHAT_ID=

# ---- delta (stablecoin cross-chain basis, :4747) ----
# DELTA_POLL_INTERVAL_MS=60000
# EPISODE_OPEN_BPS=3
# EPISODE_CLOSE_BPS=1

# ---- funding (perp funding basis, :4748) ----
# FUNDING_POLL_INTERVAL_MS=60000

# ---- spread (CEX↔DEX realizable spread, :4749) ----
# SPREAD_POLL_INTERVAL_MS=10000
# SPREAD_LATENCY_MS=10000            # how late you land; paper ledger re-prices after this
# SPREAD_SIZES=5000,25000,100000
# SPREAD_CEX=coinbase,okx            # add binance only from a non-US IP (451 otherwise)
# SPREAD_CEX_EXEC=taker              # taker | maker
# The fee tier is the whole game. Defaults are pessimal retail tiers.
# Set these to YOUR tier or the board is fiction.
# SPREAD_TAKER_BPS_COINBASE=40
# SPREAD_TAKER_BPS_OKX=10
# SPREAD_TAKER_BPS_BINANCE=10
# SPREAD_MAKER_BPS_COINBASE=10
# SPREAD_MAKER_BPS_OKX=8
# SPREAD_MAKER_BPS_BINANCE=10
# SPREAD_MAKER_ADVERSE_BPS=3
# SPREAD_GAS_USD_BASE=0.05
# SPREAD_GAS_USD_ARBITRUM=0.05
# SPREAD_REBALANCE_USD=3
# SPREAD_CLIPS_PER_REBALANCE=10
# SPREAD_EPISODE_OPEN_BPS=5
# SPREAD_EPISODE_CLOSE_BPS=1
