{
  "name": "backdraft",
  "version": "0.2.0",
  "description": "Cross-venue dislocation seismographs: stablecoin basis, perp funding basis, CEX↔DEX realizable spread — measured net of cost, paper-traded before acted on",
  "type": "module",
  "main": "dist/seismograph.js",
  "scripts": {
    "build": "tsc",
    "test": "tsx --test src/**/*.test.ts",
    "dev": "tsx watch src/seismograph.ts",
    "start": "node dist/seismograph.js",
    "delta": "tsx src/delta/main.ts",
    "delta:backfill": "tsx src/delta/backfill.ts",
    "start:delta": "node dist/delta/main.js",
    "funding": "tsx src/funding/main.ts",
    "start:funding": "node dist/funding/main.js",
    "spread": "tsx src/spread/main.ts",
    "spread:backfill": "tsx src/spread/backfill.ts",
    "start:spread": "node dist/spread/main.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "dotenv": "^16.4.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
